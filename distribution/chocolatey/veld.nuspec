<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>veld</id>
    <version>2.0.0-beta1</version>
    <title>Veld</title>
    <authors>Adhamzineldin</authors>
    <projectUrl>https://github.com/Adhamzineldin/Veld</projectUrl>
    <licenseUrl>https://github.com/Adhamzineldin/Veld/blob/master/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Contract-first API code generator.

Write .veld contracts and generate typed servers and clients (TypeScript, Node, Java).
Generated code has no runtime dependencies. Veld never overwrites files you edited.</description>
    <summary>Contract-first API code generator</summary>
    <tags>veld api codegen openapi typescript node java cli developer-tools</tags>
    <projectSourceUrl>https://github.com/Adhamzineldin/Veld</projectSourceUrl>
    <bugTrackerUrl>https://github.com/Adhamzineldin/Veld/issues</bugTrackerUrl>
    <docsUrl>https://github.com/Adhamzineldin/Veld#readme</docsUrl>
    <releaseNotes>https://github.com/Adhamzineldin/Veld/releases</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
