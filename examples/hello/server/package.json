{
  "name": "hello-server",
  "version": "1.0.0",
  "private": true,
  "description": "The hello example: an Express server implementing the generated HelloService",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --outfile=dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@veld/api": "file:src/generated",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
