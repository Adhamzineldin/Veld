{
  "name": "nexusbank-notification-service",
  "version": "1.0.0",
  "private": true,
  "description": "The notifications service of the NexusBank example",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --outfile=dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@veld/notifications-api": "file:src/generated",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
