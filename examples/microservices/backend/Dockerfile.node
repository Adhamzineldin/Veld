# One Dockerfile for every Node service. The build context is the service folder:
#   docker build -f backend/Dockerfile.node backend/iam-service
# The generated package (`@veld/<target>`, a `file:src/generated` dependency) lives inside
# the context, so `npm ci` can link it.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY tsconfig.json ./
COPY src ./src
RUN npm ci
# Type-checks, then bundles src/main.ts (with the generated code) into dist/main.js.
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/dist/main.js ./main.js
# Listen on every interface inside the container; PORT comes from docker-compose.
ENV HOST=0.0.0.0
USER node
CMD ["node", "main.js"]
