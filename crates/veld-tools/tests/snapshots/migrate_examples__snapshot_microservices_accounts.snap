source: crates/veld-tools/tests/migrate_examples.rs
expression: "render(&migrate_dir(\"microservices/veld/services/accounts\"))"
---
=== models/account.veld ===
enum AccountType { checking, savings, investment }

enum AccountStatus { active, frozen, closed }

/// A NexusBank financial account
model Account {
  id: string
  userId: string
  type: AccountType
  status: AccountStatus
  name: string
  currency: string
  balance: float
  iban: string
  createdAt: string
}

/// Payload to open a new bank account
model CreateAccountInput {
  type: AccountType
  name: string
  currency: string
}

/// Portfolio overview across all user accounts
model AccountSummary {
  totalBalance: float
  accountCount: int
  primaryAccount: Account
}

=== modules/accounts.veld ===
use models.account.{Account, AccountSummary, CreateAccountInput}

/// Bank account management — open, view, freeze, and close accounts
service Accounts at "/api/accounts" {
  /// List all accounts for the authenticated user
  @auth(bearer)
  get "/" listAccounts() -> Account[] | Unauthorized

  /// Fetch a single account by ID
  @auth(bearer)
  get "/{id}" getAccount(id: string) -> Account | Unauthorized | NotFound

  /// Open a new checking, savings, or investment account
  @auth(bearer)
  post "/" createAccount(body: CreateAccountInput) -> Account | Unauthorized | BadRequest

  /// Portfolio summary — total balance and primary account
  @auth(bearer)
  get "/summary" getSummary() -> AccountSummary | Unauthorized

  /// Freeze an account to block all future transactions
  @auth(bearer)
  post "/{id}/freeze" freezeAccount(id: string) -> Account | Unauthorized | NotFound

  /// Permanently close an account
  @auth(bearer)
  delete "/{id}" closeAccount(id: string) -> Unauthorized | NotFound

  post "/ban" banaccount() -> Unauthorized | NotFound
}

=== warnings ===
- modules/accounts.veld: middleware `AuthGuard` looks like authentication; mapped to @auth(bearer). Use @middleware(AuthGuard) or another scheme if that is wrong
