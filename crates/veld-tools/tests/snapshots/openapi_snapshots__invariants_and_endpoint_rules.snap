        "x-veld-rules": {
          "requires": [
            {
              "id": "veld:app/Bookings.createBooking.require@c76e8eafb8555c89",
              "expression": "not room.closed",
              "else": "RoomClosed"
            },
            {
              "id": "veld:app/Bookings.createBooking.require@7acfb34f494fa4cc",
              "expression": "body.guests <= room.capacity",
              "else": "RoomFull"
            },
            {
              "name": "notInPast",
              "id": "veld:app/Bookings.createBooking.notInPast@c90ac24a3c57eeb1",
              "expression": "body.start >= now",
              "message": "A booking cannot start in the past"
            },
            {
              "name": "couponWorks",
              "id": "veld:app/Bookings.createBooking.couponWorks@4c10fa7d0c6fab04",
              "expression": "has(coupon) implies coupon.percent <= 50"
            }
          ],
          "ensures": [
            {
              "name": "startsPending",
              "id": "veld:app/Bookings.createBooking.startsPending@d0dd70f9817b6ecb",
              "expression": "result.status == .pending"
            },
            {
              "name": "keepsRoom",
              "id": "veld:app/Bookings.createBooking.keepsRoom@9d274b83af791a75",
              "expression": "result.roomId == body.roomId"
            }
          ]
        },
