/**
 * Runs `call` for `req` and again whenever the canonical bytes of `req` change or `refetch` is
 * called. The previous call is aborted on a change and on unmount. `null` holds the request back.
 */
export function useQuery<Req, Res>(
  call: (req: Req, init: CallInit) => Promise<Res>,
  req: Req | null,
  enabled = true,
): QueryResult<Res> {
  const key = req === null || !enabled ? null : canonical(req);
  const [state, setState] = useState<Settled<Res> | null>(null);
  const [round, setRound] = useState(0);
  const latest = useRef({ call, req });
  latest.current = { call, req };
  useEffect(() => {
    if (key === null) return undefined;
    const aborter = newAborter();
    const { call: invoke, req: current } = latest.current;
    invoke(current as Req, { signal: aborter.signal }).then(
      (data) => {
        if (!aborter.signal.aborted) setState({ key, round, data, error: undefined });
      },
      (error: unknown) => {
        if (!aborter.signal.aborted) setState({ key, round, data: undefined, error });
      },
    );
    return () => aborter.abort();
  }, [key, round]);
  const refetch = useCallback(() => setRound((n) => n + 1), []);
  const settled = state !== null && state.key === key ? state : null;
  const loading = key !== null && (settled === null || settled.round !== round);
  return { data: settled?.data, error: loading ? undefined : settled?.error, loading, refetch };
}

interface MutationState<Res> {
  data: Res | undefined;
  error: unknown;
  loading: boolean;
}

const IDLE: MutationState<never> = { data: undefined, error: undefined, loading: false };

/** A call you trigger yourself. Only the latest `mutate` updates the state. */
export function useMutation<Req, Res>(call: (req: Req, init: CallInit) => Promise<Res>): MutationResult<Req, Res> {
  const [state, setState] = useState<MutationState<Res>>(IDLE);
  const latest = useRef(call);
  latest.current = call;
  const sequence = useRef(0);
  const mutate = useCallback(async (req: Req): Promise<Res | undefined> => {
    const mine = ++sequence.current;
    setState((s) => ({ data: s.data, error: undefined, loading: true }));
    try {
      const data = await latest.current(req, {});
      if (mine === sequence.current) setState({ data, error: undefined, loading: false });
      return data;
    } catch (error) {
      if (mine === sequence.current) setState({ data: undefined, error, loading: false });
      return undefined;
    }
  }, []);
