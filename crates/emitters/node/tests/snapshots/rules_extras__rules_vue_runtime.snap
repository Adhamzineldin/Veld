  refetch: () => void;
}

export interface MutationResult<Req, Res> {
  /** Runs the call. It never rejects: a failure lands in `error` and the promise resolves to `undefined`. */
  mutate: (req: Req) => Promise<Res | undefined>;
  data: Readonly<Ref<Res | undefined>>;
  error: Readonly<Ref<unknown>>;
  loading: Readonly<Ref<boolean>>;
  reset: () => void;
}

interface Aborter {
  signal: AbortSignalLike;
  abort(): void;
}

function newAborter(): Aborter {
  const Ctor = (globalThis as { AbortController?: new () => Aborter }).AbortController;
  if (Ctor) return new Ctor();
  const signal = { aborted: false };
  return {
    signal,
    abort: () => {
      signal.aborted = true;
    },
  };
}

/**
 * Runs `call` for the request and again whenever the canonical bytes of the request change or
 * `refetch` is called. The previous call is aborted on a change and when the scope is disposed.
 * A `null` request holds the call back.
 */
export function useQuery<Req, Res>(
  call: (req: Req, init: CallInit) => Promise<Res>,
  req: MaybeRefOrGetter<Req | null>,
  enabled?: MaybeRefOrGetter<boolean>,
): QueryResult<Res> {
  const data = shallowRef<Res | undefined>(undefined);
  const error = shallowRef<unknown>(undefined);
  const loading = shallowRef(false);
  let aborter: Aborter | null = null;

  const run = (): void => {
    aborter?.abort();
    aborter = null;
    const current = toValue(req);
    if (current === null || toValue(enabled ?? true) === false) {
      loading.value = false;
      return;
    }
    const mine = newAborter();
    aborter = mine;
    loading.value = true;
    error.value = undefined;
    call(current, { signal: mine.signal }).then(
      (result) => {
        if (mine.signal.aborted) return;
        data.value = result;
        loading.value = false;
      },
      (failure: unknown) => {
        if (mine.signal.aborted) return;
        data.value = undefined;
        error.value = failure;
        loading.value = false;
      },
    );
  };

  watch(
    () => {
      const current = toValue(req);
      return current === null || toValue(enabled ?? true) === false ? null : canonical(current);
    },
    () => {
      data.value = undefined;
      run();
    },
    { immediate: true },
  );
  if (getCurrentScope()) onScopeDispose(() => aborter?.abort());
  return { data, error, loading, refetch: run };
}

/** A call you trigger yourself. Only the latest `mutate` updates the state. */
export function useMutation<Req, Res>(call: (req: Req, init: CallInit) => Promise<Res>): MutationResult<Req, Res> {
  const data = shallowRef<Res | undefined>(undefined);
  const error = shallowRef<unknown>(undefined);
  const loading = shallowRef(false);
