/** Server-Sent Events and a chat WebSocket, open to everyone. */
export class LiveClient {
  readonly #core: veld.ClientCore;

  constructor(opts: veld.ClientOptions = {}) {
    this.#core = new veld.ClientCore(opts, {
      envVar: 'VELD_LIVE_URL',
      baseUrl: null,
      validation: (issues) => new ValidationError({ issues }),
    });
  }

  /**
   * `count` ticks. `failAt` raises a declared error after that many. A negative count raises it
   * before the first event.
   */
  ticks(req: TicksRequest, init?: veld.StreamInit): AsyncIterable<Tick> {
    return this.#core.stream(liveTicksOp, req, init) as AsyncIterable<Tick>;
  }

  /** Ticks without end, one every 20 ms, until the client goes away. */
  forever(req: ForeverRequest = {}, init?: veld.StreamInit): AsyncIterable<Tick> {
    return this.#core.stream(liveForeverOp, req, init) as AsyncIterable<Tick>;
  }

  /** Ticks with explicit event names and ids; resumes after `Last-Event-ID`. */
  roomEvents(req: RoomEventsRequest, init?: veld.StreamInit): AsyncIterable<Tick> {
    return this.#core.stream(liveRoomEventsOp, req, init) as AsyncIterable<Tick>;
  }

  /** Echo chat: every message comes back as `Heard`. */
  chat(req: ChatRequest, init?: veld.WsInit): veld.WsChannel<Heard, Say> {
    return this.#core.connect(liveChatOp, req, init) as veld.WsChannel<Heard, Say>;
  }

  /** The server only talks. */
  announce(req: AnnounceRequest = {}, init?: veld.WsInit): veld.WsChannel<Tick, never> {
    return this.#core.connect(liveAnnounceOp, req, init) as veld.WsChannel<Tick, never>;
  }

  /** The client only talks; the server stops listening after `limit` messages. */
  sink(req: SinkRequest = {}, init?: veld.WsInit): veld.WsChannel<never, Say> {
    return this.#core.connect(liveSinkOp, req, init) as veld.WsChannel<never, Say>;
  }
}

