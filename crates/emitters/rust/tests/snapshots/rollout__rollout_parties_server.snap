        }
    }

    async fn call(&self, endpoint: usize, args: serde_json::Map<String, serde_json::Value>, ctx: &veld::server::RequestContext) -> Result<serde_json::Value, veld::Error> {
        match endpoint {
            0 => {
                let request = veld::server::decode_args(args.clone())?;
                let facts = veld::server::decode_args(args)?;
                let out = self.service.watched(request, facts, ctx).await?;
                veld::server::encode_value(&out)
            }
            1 => {
                let request = veld::server::decode_args(args.clone())?;
                let facts = veld::server::decode_args(args)?;
                let out = self.service.enforced(request, facts, ctx).await?;
                veld::server::encode_value(&out)
            }
            2 => {
                let request = veld::server::decode_args(args)?;
                let out = self.service.mixed(request, ctx).await?;
                veld::server::encode_value(&out)
            }
            3 => {
                let request = veld::server::decode_args(args)?;
                let out = self.service.booking(request, ctx).await?;
                veld::server::encode_value(&out)
            }
            4 => {
                let request = veld::server::decode_args(args)?;
                let out = self.service.receipt(request, ctx).await?;
                veld::server::encode_value(&out)
            }
            _ => Err(veld::Error::other("not an HTTP endpoint")),
        }
    }
}

/// Builds the handler of the `Parties` service.
#[derive(Debug, Clone, Copy)]
pub struct PartiesHandler;

impl PartiesHandler {
    /// The handler for `service`, with `hooks` and the `loaders` of the facts the endpoint rules
    /// need. Mount it with an adapter, for example `crate::adapters::axum::router(handler)`.
    pub fn create<S: PartiesService, H: PartiesHooks, L: PartiesFactLoaders>(service: S, hooks: H, loaders: L) -> veld::server::Handler<PartiesDispatch<S, H, L>> {
        veld::server::Handler::new(PartiesDispatch { service, hooks, loaders })
    }

    /// The handler for `service` and `loaders` with the default hooks.
    pub fn plain<S: PartiesService, L: PartiesFactLoaders>(service: S, loaders: L) -> veld::server::Handler<PartiesDispatch<S, NoHooks, L>> {
        Self::create(service, NoHooks, loaders)
    }
}
