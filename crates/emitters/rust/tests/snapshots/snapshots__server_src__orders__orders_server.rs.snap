/// Order management.
///
/// Return a declared error (`Err(NotFound { .. }.into())`) to answer with its status. Any other
/// error becomes `Internal` without its message; the original goes to `on_error`.
pub trait OrdersService: Send + Sync + 'static {
    /// Fetch one order.
    fn get_order(&self, request: GetOrderRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<crate::orders::orders::Order, veld::Error>> + Send;

    fn create_order(&self, request: CreateOrderRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<crate::orders::orders::Order, veld::Error>> + Send;

    fn list_orders(&self, request: ListOrdersRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<veld::Page<crate::orders::orders::Order>, veld::Error>> + Send;

    fn search_orders(&self, request: SearchOrdersRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<Vec<crate::orders::orders::Order>, veld::Error>> + Send;

    fn pay_order(&self, request: PayOrderRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<crate::orders::orders::Order, veld::Error>> + Send;

    fn cancel_order(&self, request: CancelOrderRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<(), veld::Error>> + Send;

    fn health(&self, request: HealthRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<(), veld::Error>> + Send;

    fn boom(&self, request: BoomRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<crate::orders::orders::Order, veld::Error>> + Send;

}

