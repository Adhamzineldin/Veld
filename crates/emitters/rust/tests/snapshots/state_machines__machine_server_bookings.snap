        match prepared.index() {
            0 => step9_pay_booking(prepared, result),
            1 => step9_cancel_booking(prepared, result),
            _ => Vec::new(),
        }
    }

    async fn call(&self, endpoint: usize, args: serde_json::Map<String, serde_json::Value>, ctx: &veld::server::RequestContext) -> Result<serde_json::Value, veld::Error> {
        match endpoint {
            0 => {
                let request = veld::server::decode_args(args.clone())?;
                let facts = veld::server::decode_args(args.clone())?;
                let transition = veld::server::decode_key(&args, "transition")?;
                let out = self.service.pay_booking(request, facts, transition, ctx).await?;
                veld::server::encode_value(&out)
            }
            1 => {
                let request = veld::server::decode_args(args.clone())?;
                let facts = veld::server::decode_args(args.clone())?;
                let transition = veld::server::decode_key(&args, "transition")?;
                let out = self.service.cancel_booking(request, facts, transition, ctx).await?;
                veld::server::encode_value(&out)
            }
            2 => {
                let request = veld::server::decode_args(args.clone())?;
                let facts = veld::server::decode_args(args.clone())?;
                let transition = veld::server::decode_key(&args, "transition")?;
                self.service.check_in(request, facts, transition, ctx).await?;
                Ok(serde_json::Value::Null)
            }
            _ => Err(veld::Error::other("not an HTTP endpoint")),
        }
    }
}

/// Builds the handler of the `Bookings` service.
#[derive(Debug, Clone, Copy)]
pub struct BookingsHandler;

impl BookingsHandler {
    /// The handler for `service`, with `hooks` and the `loaders` of the facts the endpoint rules
    /// need. Mount it with an adapter, for example `crate::adapters::axum::router(handler)`.
    pub fn create<S: BookingsService, H: BookingsHooks, L: BookingsFactLoaders>(service: S, hooks: H, loaders: L) -> veld::server::Handler<BookingsDispatch<S, H, L>> {
        veld::server::Handler::new(BookingsDispatch { service, hooks, loaders })
    }

    /// The handler for `service` and `loaders` with the default hooks.
    pub fn plain<S: BookingsService, L: BookingsFactLoaders>(service: S, loaders: L) -> veld::server::Handler<BookingsDispatch<S, NoHooks, L>> {
        Self::create(service, NoHooks, loaders)
    }
}
