//! The test handler of the `Parties` service (`spec/rules.md` section 12.4).
//!
//! THE VELD TEST HANDLER. NEVER MOUNT IT IN PRODUCTION.
//!
//! It lets whoever sends a request choose the facts, the principal, the clock and the result of
//! that request (`Veld-Test-*` headers), and it skips authentication and middleware. It exists so
//! `veld test --live` can run the examples of a contract against this server. Creating it reports
//! that once.

use crate::veld;

use crate::rollout::parties_server::{PartiesDispatch, PartiesHooks, PartiesService, PartiesFactLoaders, NoHooks, step6_watched, step6_enforced};
use crate::veld::server::{Body, Endpoints, Halt, Handler, Principal, Prepared, RequestContext, Response};

/// Standard or url-safe base64, padded or not.
fn b64(text: &str) -> Option<Vec<u8>> {
    let (mut out, mut acc, mut bits) = (Vec::new(), 0u32, 0u32);
    for c in text.bytes() {
        let v = match c {
            b'A'..=b'Z' => c - b'A',
            b'a'..=b'z' => c - b'a' + 26,
            b'0'..=b'9' => c - b'0' + 52,
            b'+' | b'-' => 62,
            b'/' | b'_' => 63,
            b'=' => continue,
            _ => return None,
        };
        acc = (acc << 6) | u32::from(v);
        bits += 6;
        if bits >= 8 {
            bits -= 8;
            out.push(u8::try_from((acc >> bits) & 0xff).ok()?);
        }
    }
    Some(out)
}

/// The JSON of a header that carries base64url JSON; `None` when it is absent.
fn header_json(ctx: &RequestContext, name: &str) -> Result<Option<serde_json::Value>, veld::Error> {
    let Some(text) = ctx.header(name) else { return Ok(None) };
    let bytes = b64(text).ok_or_else(|| veld::Error::other(format!("the header {name} is not base64url")))?;
    serde_json::from_slice(&bytes).map(Some).map_err(|e| veld::Error::other(format!("the header {name} is not JSON: {e}")))
}

/// A fact of `Veld-Test-Facts`: absent when the object has none or it is `null`.
fn fact<T: serde::de::DeserializeOwned>(ctx: &RequestContext, name: &str, schema: &'static veld::schema::Schema) -> Result<Option<T>, veld::Error> {
    let Some(serde_json::Value::Object(facts)) = header_json(ctx, "veld-test-facts")? else { return Ok(None) };
    match facts.get(name) {
        None | Some(serde_json::Value::Null) => Ok(None),
        Some(wire) => serde_json::from_value(schema.from_wire(wire, false)).map(Some).map_err(veld::Error::other),
    }
}

/// Loaders that read the facts from the request instead of the application.
#[derive(Debug, Clone, Copy)]
pub struct HeaderFacts;

impl PartiesFactLoaders for HeaderFacts {
    fn room(&self, _key: String, ctx: &RequestContext) -> impl std::future::Future<Output = Result<Option<crate::rollout::rollout::Room>, veld::Error>> + Send {
        std::future::ready(fact(ctx, "room", &crate::rollout::rollout::ROOM_SCHEMA))
    }

}

/// The dispatch of the test handler: the production dispatch, with the test steps in front.
pub struct PartiesTestDispatch<S, H> {
    inner: PartiesDispatch<S, H, HeaderFacts>,
}

