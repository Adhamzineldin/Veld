    }

    fn test_audited(&self) -> bool {
        true
    }

    fn ensure_audited(&self, prepared: &Prepared, result: &serde_json::Value) -> Vec<veld::rules::Violation> {
        self.inner.ensure_audited(prepared, result)
    }

    async fn prepare(&self, endpoint: usize, args: &mut serde_json::Map<String, serde_json::Value>, ctx: &RequestContext) -> Result<Prepared, Halt> {
        let enforce = self.inner.hooks.validate_requests();
        let now = match ctx.header("veld-test-now") {
            Some(text) => veld::rules::instant::parse_datetime(text).ok_or_else(|| Halt::Error(veld::Error::other("the header Veld-Test-Now is not an RFC 3339 time")))?,
            None => veld::rules::clock_ms(self.inner.hooks.clock(ctx)),
        };
        let prepared = match endpoint {
            0 => step6_watched(&HeaderFacts, now, enforce, args, ctx).await?,
            1 => step6_enforced(&HeaderFacts, now, enforce, args, ctx).await?,
            _ => Prepared::none(),
        };
        if ctx.header("veld-test-dry-run") == Some("1") {
            return Err(Halt::Early(Response { status: 204, headers: vec![("veld-test-passed".to_string(), "1".to_string())], body: Body::Empty }));
        }
        Ok(prepared)
    }

    fn trusted_principal(&self, ctx: &RequestContext) -> Option<Principal> {
        Some(Principal::new(header_json(ctx, "veld-test-principal").ok().flatten().unwrap_or(serde_json::Value::Null)))
    }

    async fn call(&self, endpoint: usize, args: serde_json::Map<String, serde_json::Value>, ctx: &RequestContext) -> Result<serde_json::Value, veld::Error> {
        if let Some(wire) = header_json(ctx, "veld-test-result")? {
            let schema = self.inner.endpoints().get(endpoint).and_then(|e| e.success);
            return Ok(schema.map_or(serde_json::Value::Null, |s| s.from_wire(&wire, false)));
        }
        self.inner.call(endpoint, args, ctx).await
    }

}

/// Builds the test handler of the service. Creating it says so once: never mount it in
/// production.
#[derive(Debug, Clone, Copy)]
pub struct PartiesTestHandler;

impl PartiesTestHandler {
    /// The test handler for `service`, with `hooks` (their authentication and middleware are not called).
    pub fn create<S: PartiesService, H: PartiesHooks>(service: S, hooks: H) -> Handler<PartiesTestDispatch<S, H>> {
        eprintln!("veld: the test handler of `Parties` is running: anyone can choose the facts, the principal and the clock of a request. Never mount it in production.");
        Handler::new(PartiesTestDispatch { inner: PartiesDispatch { service, hooks, loaders: HeaderFacts } })
    }

    /// The test handler for `service` with the default hooks.
    pub fn plain<S: PartiesService>(service: S) -> Handler<PartiesTestDispatch<S, NoHooks>> {
        Self::create(service, NoHooks)
    }
}

/// The body of `GET /__veld/test`: it tells a test handler from a production server and
/// holds the rules digests of its service.
pub fn probe() -> String {
    "{\"veldTestHandler\":1,\"digests\":{\"Parties\":\"62cad6b76878756d\"}}".to_string()
}

/// The routes of the test handler: the endpoints and `GET /__veld/test`.
pub fn router<S: PartiesService, H: PartiesHooks>(handler: Handler<PartiesTestDispatch<S, H>>) -> ::axum::Router {
    crate::adapters::axum::router(handler).route("/__veld/test", ::axum::routing::get(|| async { ([(::axum::http::header::CONTENT_TYPE, "application/json")], probe()) }))
}
