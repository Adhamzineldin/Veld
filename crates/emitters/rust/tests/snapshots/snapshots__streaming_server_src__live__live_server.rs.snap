    /// The client only talks; the server stops listening after `limit` messages.
    fn sink(&self, request: SinkRequest, ctx: &veld::server::RequestContext, ws: veld::server::WsSession<crate::live::live::Say, ()>) -> impl std::future::Future<Output = Result<(), veld::Error>> + Send;

