    /// Ticks without end, one every 20 ms, until the client goes away.
    fn forever(&self, request: ForeverRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<veld::stream::EventStream<crate::live::live::Tick>, veld::Error>> + Send;

    /// Ticks with explicit event names and ids; resumes after `Last-Event-ID`.
    fn room_events(&self, request: RoomEventsRequest, ctx: &veld::server::RequestContext) -> impl std::future::Future<Output = Result<veld::stream::EventStream<crate::live::live::Tick>, veld::Error>> + Send;

    /// Echo chat: every message comes back as `Heard`.
