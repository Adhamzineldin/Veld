// Code generated by veld. DO NOT EDIT.
package gen.sf.runtime;

import java.util.ArrayList;
import java.util.List;

/**
 * Incremental parser of a {@code text/event-stream} body (WHATWG HTML section 9.2): lines end in
 * {@code \n}, {@code \r\n} or {@code \r}, {@code :} lines are comments, a blank line dispatches
 * the event, an event without data is dropped, and an event cut off by the end of the stream is
 * discarded.
 */
public final class SseParser {

  /**
   * A dispatched event.
   *
   * @param event the event name, {@code message} when the event had none
   * @param data the data lines joined with a line feed
   * @param id the last {@code id} seen so far, or {@code null}
   */
  public record Message(String event, String data, String id) {}

  private final StringBuilder buf = new StringBuilder();
  private final List<String> data = new ArrayList<>();
  private String event = "";
  private String id;
  private boolean first = true;

  /** Feeds a chunk of text (it may end anywhere) and returns the events it completed. */
  public List<Message> push(String chunk) {
    buf.append(chunk);
    if (first && buf.length() > 0) {
      first = false;
      if (buf.charAt(0) == '﻿') {
        buf.deleteCharAt(0);
      }
    }
    List<Message> out = new ArrayList<>();
    int start = 0;
    int n = buf.length();
    while (true) {
      int end = start;
      while (end < n && buf.charAt(end) != '\n' && buf.charAt(end) != '\r') {
        end++;
      }
      if (end >= n) {
        break;
      }
      // A trailing CR may be the first half of CRLF: wait for the next chunk.
      if (buf.charAt(end) == '\r' && end + 1 >= n) {
        break;
      }
      line(buf.substring(start, end), out);
      start = end + (buf.charAt(end) == '\r' && buf.charAt(end + 1) == '\n' ? 2 : 1);
    }
    buf.delete(0, start);
    return out;
  }

  private void line(String line, List<Message> out) {
    if (line.isEmpty()) {
      if (!data.isEmpty()) {
        out.add(new Message(event.isEmpty() ? "message" : event, String.join("\n", data), id));
      }
      data.clear();
      event = "";
      return;
    }
    if (line.startsWith(":")) {
      return;
    }
    int colon = line.indexOf(':');
    String field = colon < 0 ? line : line.substring(0, colon);
    String value = colon < 0 ? "" : line.substring(colon + 1);
    if (value.startsWith(" ")) {
      value = value.substring(1);
    }
    switch (field) {
      case "data" -> data.add(value);
      case "event" -> event = value;
      case "id" -> {
        if (value.indexOf('\u0000') < 0) {
          id = value;
        }
      }
      default -> { }
    }
  }
}
