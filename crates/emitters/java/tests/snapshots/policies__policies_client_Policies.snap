// Code generated by veld. DO NOT EDIT.
package gen.b.bookings.bookings;

import gen.b.runtime.Policy;
import gen.b.runtime.Rules;

/** The policies of the contract (spec/rules.md section 11). Each has a boolean method and a verdict method; the server calls the verdict method. */
@SuppressWarnings("deprecation")
public final class Policies {
  private Policies() {}

  /**
   * The policy `AnyRole`.
   *
   * Whether the policy permits, read at the system clock. A clause that cannot be evaluated fails closed.
   */
  public static boolean anyRole(User user) {
    return anyRoleVerdict(user, System.currentTimeMillis()).permitted();
  }

  /** The policy `AnyRole` at the instant `now` (epoch milliseconds), with the message of the first `forbid` that was true. */
  public static Policy.Verdict anyRoleVerdict(User user, long now) {
    return Policy.Verdict.of(Policy.permits(() -> user.roles().size() > 0));
  }

  /**
   * The policy `ManageBooking`.
   *
   * Whether the policy permits, read at the system clock. A clause that cannot be evaluated fails closed.
   */
  public static boolean manageBooking(User user, Booking booking) {
    return manageBookingVerdict(user, booking, System.currentTimeMillis()).permitted();
  }

  /** The policy `ManageBooking` at the instant `now` (epoch milliseconds), with the message of the first `forbid` that was true. */
  public static Policy.Verdict manageBookingVerdict(User user, Booking booking, long now) {
    if (Policy.forbids(() -> user.suspended())) {
      return Policy.Verdict.denied("A suspended account cannot manage bookings");
    }
    return Policy.Verdict.of(Policy.permits(() -> booking.guestId().equals(user.id())) || Policy.permits(() -> Rules.in(user.roles(), "support")));
  }
}
