package gen.s.adapters.live;

import gen.s.adapters.SpringWebSocketAdapter;
import gen.s.live.server.LiveHandler;
import gen.s.live.server.LiveHooks;
import gen.s.live.server.LiveService;
import gen.s.runtime.VeldHandler;
import org.springframework.beans.factory.ObjectProvider;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.socket.config.annotation.EnableWebSocket;
import org.springframework.web.socket.config.annotation.WebSocketConfigurer;
import org.springframework.web.socket.config.annotation.WebSocketHandlerRegistry;

/** Registers the `ws` endpoints of the `Live` service with Spring WebSocket. */
@Configuration
@EnableWebSocket
public class LiveWebSocketConfig implements WebSocketConfigurer {
  private final VeldHandler handler;

  /** Creates the configuration from the LiveService bean and its hooks. */
  public LiveWebSocketConfig(LiveService service, ObjectProvider<LiveHooks> hooks) {
    this.handler = LiveHandler.create(service, hooks.getIfAvailable(LiveHooks::new));
  }

  @Override
  public void registerWebSocketHandlers(WebSocketHandlerRegistry registry) {
    registry.addHandler(SpringWebSocketAdapter.handler(handler), "/live/chat/*", "/live/announce", "/live/sink");
  }
}
