  /** Echo chat: every message comes back as `Heard`. */
  void chat(ChatRequest request, RequestContext ctx, WsSession<Say, Heard> ws) throws Exception;

  /** The server only talks. */
  void announce(AnnounceRequest request, RequestContext ctx, WsSession<Void, Tick> ws) throws Exception;

  /** The client only talks; the server stops listening after `limit` messages. */
