# ── Binaries ────────────────────────────────────────────────────────────────
# Build output is never committed. Build with: cargo build -p veld --release (output in target/).
# Leading slashes anchor these to the repo ROOT.
/veld
/veld.exe
/veld-registry
/veld-registry.exe
/generate-language
/generate-language.exe
go_build_*.exe

# ── Go ───────────────────────────────────────────────────────────────────────
*.test
*.out
/vendor/

# ── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── TypeScript build output ───────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Editor plugin packages ────────────────────────────────────────────────────
# Package locally with: cd editors/vscode && npx vsce package
*.vsix

# ── Veld generated output ────────────────────────────────────────────────────
# Regenerate with: veld generate
testapp/generated/
testdata/generated/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Gradle (JetBrains plugin) ─────────────────────────────────────────────────
editors/jetbrains/.gradle/
editors/jetbrains/.intellijPlatform/
editors/jetbrains/.kotlin/
editors/jetbrains/build/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
# .idea/ is kept — contains Go SDK config needed for GoLand

/Veld Test/
generated/
!/examples/**/generated/
!/examples/**/generated/**


/target/

# Veld 2.0 toolchain tests
/tests/toolchain/ts/node_modules/
/tests/toolchain/ts/.work/
/tests/toolchain/java/.work/
/tests/toolchain/rust/.work/
/veld
/veld.exe
.idea/
.veld/

# Examples: build tooling output (generated code itself is committed)
examples/**/.veld/
examples/**/node_modules/
examples/**/veld.exe
archive/**/veld.exe

# Generated by website/scripts/build-wasm.mjs (the playground engine)
website/src/wasm/
