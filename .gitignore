# ── Binaries ────────────────────────────────────────────────────────────────
# Build output is never committed — build with: go build -o veld ./cmd/veld
# Leading slash anchors these to the repo ROOT. A bare `veld` would also match
# the cmd/veld/ SOURCE DIRECTORY and silently exclude every .go file inside it.
/veld
/veld.exe
/registry
/registry.exe
/veld-registry
/veld-registry.exe
/generate-language
/generate-language.exe
go_build_*.exe

# ── Go ───────────────────────────────────────────────────────────────────────
*.test
*.out
/vendor/

# ── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── TypeScript build output ───────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Editor plugin packages ────────────────────────────────────────────────────
# Package locally with: cd editors/vscode && npx vsce package
*.vsix

# ── Veld generated output ────────────────────────────────────────────────────
# Regenerate with: veld generate
testapp/generated/
testdata/generated/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Gradle (JetBrains plugin) ─────────────────────────────────────────────────
editors/jetbrains/.gradle/
editors/jetbrains/.intellijPlatform/
editors/jetbrains/.kotlin/
editors/jetbrains/build/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
# .idea/ is kept — contains Go SDK config needed for GoLand

/Veld Test/
generated/


# Generated by: go run ./cmd/generate-language
veld-language.json
