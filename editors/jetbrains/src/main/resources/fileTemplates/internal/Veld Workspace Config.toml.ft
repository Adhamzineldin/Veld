# The workspace root. Each member has its own veld.toml in its directory:
#   services/users/veld.toml    [service]
#   services/orders/veld.toml   [service] consumes = ["users"], and a [server]
#   apps/web/veld.toml          [app], and a [client]
[workspace]
name = "workspace"
members = ["services/*", "apps/*"]

[workspace.defaults.server.node]
framework = "express"
