{
  "name": "veld-vscode",
  "displayName": "Veld",
  "description": "Veld contract language support: a thin client for the `veld lsp` language server",
  "version": "2.0.0",
  "publisher": "adhamzineldin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "icon": "icon.png",
  "keywords": ["veld", "api", "contract", "code-generation", "lsp"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Adhamzineldin/Veld"
  },
  "activationEvents": [
    "onLanguage:veld",
    "workspaceContains:**/*.veld",
    "workspaceContains:veld.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "veld",
        "aliases": ["Veld", "veld"],
        "extensions": [".veld"],
        "icon": {
          "light": "./icons/veld-file.png",
          "dark": "./icons/veld-file.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "veld",
        "scopeName": "source.veld",
        "path": "./syntaxes/veld.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Veld",
      "properties": {
        "veld.path": {
          "type": "string",
          "default": "veld",
          "scope": "machine-overridable",
          "description": "Path to the `veld` executable that is started as `veld lsp`. The default finds it on PATH."
        },
        "veld.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the Veld language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  }
}
