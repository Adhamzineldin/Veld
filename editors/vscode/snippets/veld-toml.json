{
  "Single service": {
    "prefix": "veld-single",
    "description": "veld.toml for one service (the single file form)",
    "body": [
      "[service]",
      "name = \"${1:shop}\"",
      "",
      "$0"
    ]
  },
  "Workspace": {
    "prefix": "veld-workspace",
    "description": "Root veld.toml of a workspace",
    "body": [
      "[workspace]",
      "name = \"${1:acme}\"",
      "members = [\"${2:services/*}\", \"${3:apps/*}\"]",
      "",
      "$0"
    ]
  },
  "Workspace defaults": {
    "prefix": "veld-defaults",
    "description": "Defaults for the targets of one role and emitter",
    "body": [
      "[workspace.defaults.${1|server,client|}.${2:node}]",
      "framework = \"${3:express}\""
    ]
  },
  "Library": {
    "prefix": "veld-library",
    "description": "veld.toml of a member with shared contracts importable by services",
    "body": ["[library]", "owners = [\"${1:team-platform}\"]"]
  },
  "Service": {
    "prefix": "veld-service",
    "description": "veld.toml of a service member",
    "body": [
      "[service]",
      "base-url = \"http://${1:payments}:${2:3002}\"",
      "consumes = [$3]",
      "owners = [\"${4:team-payments}\"]"
    ]
  },
  "App": {
    "prefix": "veld-app",
    "description": "veld.toml of an app member (clients of services)",
    "body": ["[app]", "uses = [$1]", "owners = [\"${2:team-web}\"]"]
  },
  "Server target (node)": {
    "prefix": "veld-node",
    "description": "Node server target",
    "body": [
      "[server]",
      "emitter = \"node\"",
      "framework = \"${1|express,fastify,hono,node-http,nest|}\"",
      "out = \"${2:src/generated}\""
    ]
  },
  "Server target (java)": {
    "prefix": "veld-java",
    "description": "Java server target",
    "body": [
      "[server]",
      "emitter = \"java\"",
      "framework = \"${1|jdk,spring|}\"",
      "out = \"${2:src/main/java}\"",
      "",
      "[server.options]",
      "package = \"${3:com.acme.shop}\"",
      "java = \"${4|17,21|}\""
    ]
  },
  "Client target (typescript)": {
    "prefix": "veld-typescript",
    "description": "TypeScript client target",
    "body": [
      "[client]",
      "emitter = \"typescript\"",
      "out = \"${1:src/generated}\""
    ]
  },
  "Client target (react)": {
    "prefix": "veld-react",
    "description": "TypeScript client with React hooks",
    "body": [
      "[client]",
      "emitter = \"typescript\"",
      "framework = \"react\"",
      "out = \"${1:src/generated}\""
    ]
  },
  "Client target (vue)": {
    "prefix": "veld-vue",
    "description": "TypeScript client with Vue composables",
    "body": [
      "[client]",
      "emitter = \"typescript\"",
      "framework = \"vue\"",
      "out = \"${1:src/generated}\""
    ]
  },
  "Client target (java)": {
    "prefix": "veld-javaclient",
    "description": "Java client target",
    "body": [
      "[client]",
      "emitter = \"java\"",
      "out = \"${1:src/main/java}\"",
      "",
      "[client.options]",
      "package = \"${2:com.acme.client}\""
    ]
  },
  "Server target (rust)": {
    "prefix": "veld-rust",
    "description": "Rust server target (a Cargo crate with an axum adapter)",
    "body": [
      "[server]",
      "emitter = \"rust\"",
      "framework = \"axum\"",
      "out = \"${1:generated}\"",
      "",
      "[server.options]",
      "crate-name = \"${2:shop-server}\""
    ]
  },
  "Client target (rust)": {
    "prefix": "veld-rustclient",
    "description": "Rust client target (generic over its HTTP transport)",
    "body": [
      "[client]",
      "emitter = \"rust\"",
      "framework = \"${1|reqwest,ureq|}\"",
      "out = \"${2:generated}\"",
      "",
      "[client.options]",
      "crate-name = \"${3:shop-client}\""
    ]
  },
  "Plugin": {
    "prefix": "veld-plugin",
    "description": "Generator plugin (workspace root) and a target that uses it (member)",
    "body": [
      "[plugins.${1:kotlin}]",
      "command = \"${2:veld-emit-kotlin}\"",
      "version = \"${3:1.0.0}\"",
      "sha256 = \"${4:hash}\"",
      "",
      "[${5|server,client|}]",
      "emitter = \"plugin:${1:kotlin}\"",
      "out = \"${6:generated}\""
    ]
  },
  "Registry dependency": {
    "prefix": "veld-dependency",
    "description": "Registry and a package dependency (workspace root)",
    "body": [
      "[registry]",
      "url = \"${1:https://registry.example.com}\"",
      "",
      "[dependencies]",
      "\"@${2:acme}/${3:billing}\" = \"^${4:1.0}\""
    ]
  },
  "Lint levels": {
    "prefix": "veld-lint",
    "description": "Configure lint rule levels (workspace root)",
    "body": ["[lint]", "${1:unused-model} = \"${2|off,warn,error|}\""]
  }
}
