{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Veld",
  "scopeName": "source.veld",
  "fileTypes": [
    "veld"
  ],
  "comment": "Generated by `cargo xtask codegen` from editors/veld-language.json. Do not edit.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#use"
    },
    {
      "include": "#arrow"
    },
    {
      "include": "#rules"
    },
    {
      "include": "#methods"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#variants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#fields"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.veld",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.veld",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.veld",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.veld",
          "match": "\\\\."
        },
        {
          "name": "variable.parameter.path.veld",
          "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.annotation.veld",
          "match": "@(auth|middleware|deprecated|min|max|length|pattern|format|readonly|wire|example|discriminator|query|header|topic|rollout|version|idempotent)\\b"
        },
        {
          "name": "invalid.illegal.unknown-annotation.veld",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(model|enum|error|union|service|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.veld"
            },
            "2": {
              "name": "entity.name.type.veld"
            }
          }
        },
        {
          "match": "\\b(extends)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.veld"
            },
            "2": {
              "name": "entity.other.inherited-class.veld"
            }
          }
        }
      ]
    },
    "use": {
      "match": "^\\s*(use)\\s+(?:(@?[A-Za-z0-9_/]+)(:))?([A-Za-z_][A-Za-z0-9_.]*)",
      "captures": {
        "1": {
          "name": "keyword.control.import.veld"
        },
        "2": {
          "name": "entity.name.namespace.package.veld"
        },
        "3": {
          "name": "punctuation.separator.veld"
        },
        "4": {
          "name": "entity.name.namespace.module.veld"
        }
      }
    },
    "arrow": {
      "name": "keyword.operator.arrow.veld",
      "match": "->|\\|"
    },
    "rules": {
      "patterns": [
        {
          "match": "^\\s*(rule)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)",
          "captures": {
            "1": {
              "name": "keyword.control.rule.veld"
            },
            "2": {
              "name": "entity.name.function.rule.veld"
            }
          }
        },
        {
          "match": "^\\s*(message)(?=\\s+\")",
          "captures": {
            "1": {
              "name": "keyword.control.rule.veld"
            }
          }
        },
        {
          "name": "keyword.operator.word.veld",
          "match": "(?<=\\s)(implies|not|in)(?=\\s)"
        },
        {
          "name": "support.function.builtin.veld",
          "match": "\\b(has)(?=\\()"
        },
        {
          "name": "keyword.operator.logical.veld",
          "match": "&&|\\|\\||==|!=|<=|>=|=>"
        }
      ]
    },
    "methods": {
      "name": "keyword.control.http-method.veld",
      "match": "^\\s*\\b(get|post|put|patch|delete|head|options|ws)\\b(?=\\s+\")"
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.veld",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.numeric.veld",
          "match": "\\b-?\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "variants": {
      "name": "constant.other.enum-member.veld",
      "match": "(?<=[=\\s])\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    "keywords": {
      "name": "keyword.other.veld",
      "match": "\\b(use|as|model|enum|error|union|service|at|extends|const|stream)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.veld",
          "match": "\\b(string|int|long|float|decimal|bool|date|datetime|time|uuid|bytes|json)\\b"
        },
        {
          "name": "support.type.generic.veld",
          "match": "\\b(Map|Page)\\b"
        },
        {
          "name": "support.class.error.veld",
          "match": "\\b(BadRequest|Unauthorized|Forbidden|NotFound|Conflict|ValidationError|TooManyRequests|Internal|InvalidTransition|PreconditionFailed)\\b"
        },
        {
          "name": "entity.name.type.reference.veld",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "fields": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(\\??)\\s*(?=:)",
      "captures": {
        "1": {
          "name": "variable.other.property.veld"
        },
        "2": {
          "name": "keyword.operator.optional.veld"
        }
      }
    }
  }
}
