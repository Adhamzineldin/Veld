// Timed moves behind auth, for the due-moves runner (spec/platform.md section 10.1): the timer
// calls `expireBooking` as the principal the application gives it.
enum Status {
  pending, paid, cancelled
  flow pending -> paid
  flow pending -> cancelled after hours(24)
  final paid, cancelled
}

model Booking {
  id: uuid
  status: Status = .pending
  pendingSince: datetime
}

service Bookings at "/bookings" {
  @auth(bearer)
  post "/{id}/expire" expireBooking(id: uuid) -> Booking {
    fact booking: Booking = id
    transition booking.status: pending -> cancelled since booking.pendingSince
  }

  @auth(none)
  post "/{id}/archive" archiveBooking(id: uuid) -> Booking {
    fact booking: Booking = id
    transition booking.status: pending -> cancelled since booking.pendingSince
  }
}
