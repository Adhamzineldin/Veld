// Flags on a require, a permit, a forbid and a flow (spec/platform.md section 11), for the production
// handler and the client. The service and the models are those of tests/rules/endpoints/flags.veld.pending.

model User {
  id: uuid
  roles: string[]
}

principal User

enum Phase {
  draft, live, archived
  flow draft -> live
  flow live -> archived when flag("archiving")
  final archived
}

model Room {
  id: uuid
  open: bool
  capacity: int
  phase: Phase = .draft
}

policy Manage(user: User, room: Room) {
  permit when "staff" in user.roles
  permit when "beta" in user.roles when flag("betaDesk")
  forbid when "suspended" in user.roles
    message "suspended" when flag("lockSuspended")
}

@auth(bearer)
service Rooms at "/rooms" {
  post "/{id}/book" bookRoom(id: uuid) -> Room {
    fact room: Room = id
    allow Manage(user, room)
    require room.capacity > 0
    require room.open when flag("openOnly")
  }

  post "/{id}/publish" publishRoom(id: uuid) -> Room {
    fact room: Room = id
    allow Manage(user, room)
    transition room.phase: draft -> live
  }

  post "/{id}/archive" archiveRoom(id: uuid) -> Room {
    fact room: Room = id
    allow Manage(user, room)
    transition room.phase: live -> archived
  }

  // The operand of `old(...)` fails (a division by zero) when the capacity is 0, and only this
  // flagged `ensure` reads it: with the flag off the statement is gone, and so is the operand.
  post "/{id}/resize" resizeRoom(id: uuid) -> Room {
    fact room: Room = id
    ensure result.capacity * old(100 / room.capacity) > 0 when flag("capacityGuard")
  }
}
