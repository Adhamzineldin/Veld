{ "cases": [
  { "name": "a line computes its total and its units", "type": "Line",
    "value": { "price": "2.50", "qty": 3 },
    "computed": { "$.units": 6 }, "expect": [] },
  { "name": "an invariant reads the computed total", "type": "Line",
    "value": { "price": "50", "qty": 3 },
    "computed": { "$.units": 6 },
    "expect": [ { "rule": "cheap", "path": "$", "fields": ["total"] } ] },
  { "name": "a value the caller sent for a derived field is replaced", "type": "Line", "request": true,
    "value": { "price": "50", "qty": 3, "total": "1", "units": 999 },
    "computed": { "$.units": 6 },
    "expect": [ { "rule": "cheap", "path": "$", "fields": ["total"] } ] },
  { "name": "a value the caller sent is dropped even when it is malformed", "type": "Line", "request": true,
    "value": { "price": "1", "qty": 1, "total": 12, "units": "x" },
    "computed": { "$.units": 2 }, "expect": [] },

  { "name": "a sum over the derived totals of the items", "type": "Order",
    "value": { "items": [ { "price": "2.50", "qty": 2 }, { "price": "1", "qty": 1 } ], "discount": "1" },
    "computed": { "$.count": 2, "$.items[0].units": 4, "$.items[1].units": 2 }, "expect": [] },
  { "name": "the default is applied before the derived fields", "type": "Order",
    "value": { "items": [ { "price": "1", "qty": 1 } ] },
    "computed": { "$.count": 1 }, "expect": [] },
  { "name": "the sum of no items is zero, so the total goes negative", "type": "Order",
    "value": { "items": [], "discount": "1" },
    "computed": { "$.count": 0 },
    "expect": [ { "rule": "notNegative", "path": "$", "fields": ["total"] },
                { "rule": "discountFits", "path": "$", "fields": ["discount", "subtotal"] } ] },
  { "name": "an invariant of an item sees the total of the item", "type": "Order",
    "value": { "items": [ { "price": "500", "qty": 1 } ] },
    "expect": [ { "rule": "cheap", "path": "$.items[0]", "fields": ["total"] } ] },

  { "name": "a chain declared out of order", "type": "Chain", "value": { "a": 3 },
    "computed": { "$.b": 6, "$.c": 7, "$.d": 13 }, "expect": [] },
  { "name": "a chain that ends in a violation", "type": "Chain", "value": { "a": 30 },
    "computed": { "$.b": 60, "$.c": 61, "$.d": 121 },
    "expect": [ { "rule": "small", "path": "$", "fields": ["d"] } ] },

  { "name": "an expression that works", "type": "Risky", "value": { "n": 5 },
    "computed": { "$.next": 6, "$.ratio": 20 }, "expect": [] },
  { "name": "a division by zero leaves the field absent and skips the rule that reads it", "type": "Risky",
    "value": { "n": 0 },
    "computed": { "$.next": 1, "$.ratio": null },
    "expect": [ { "rule": "ratio", "path": "$", "fields": ["n"], "error": "division_by_zero" } ] },
  { "name": "an overflow leaves the field absent, and the other field is still computed", "type": "Risky",
    "value": { "n": 2147483647 },
    "computed": { "$.next": null, "$.ratio": 0 },
    "expect": [ { "rule": "next", "path": "$", "fields": ["n"], "error": "overflow" },
                { "rule": "positive", "path": "$", "fields": ["ratio"] } ] },

  { "name": "an inherited derived field is computed on the child", "type": "Child",
    "value": { "a": 1, "b": 2 },
    "computed": { "$.double": 2, "$.sum": 4 }, "expect": [] },
  { "name": "a rule of the child reads the derived field of the parent through another", "type": "Child",
    "value": { "a": 4, "b": 3 },
    "computed": { "$.double": 8, "$.sum": 11 },
    "expect": [ { "rule": "below", "path": "$", "fields": ["sum"] } ] },

  { "name": "derived fields inside a field, a list, a map and a page", "type": "Holder",
    "value": { "child": { "a": 1, "b": 2 },
               "many": [ { "a": 5, "b": 1 } ],
               "named": { "k": { "a": 0, "b": 0 } },
               "page": { "items": [ { "a": 1, "b": 9 } ], "total": "1", "page": 1, "size": 10 } },
    "computed": { "$.child.sum": 4, "$.many[0].sum": 11, "$.named.k.double": 0, "$.page.items[0].double": 2 },
    "expect": [ { "rule": "below", "path": "$.many[0]", "fields": ["sum"] },
                { "rule": "below", "path": "$.page.items[0]", "fields": ["sum"] } ] },
  { "name": "an optional nested model has its derived fields when it is there", "type": "Holder",
    "value": { "child": { "a": 0, "b": 0 }, "many": [], "named": {}, "main": { "a": 2, "b": 1 },
               "page": { "items": [], "total": "0", "page": 1, "size": 0 } },
    "computed": { "$.main.sum": 5 }, "expect": [] },

  { "name": "a union arm with a derived field", "type": "Basket",
    "value": { "offer": { "kind": "priced", "qty": 60 } },
    "computed": { "$.offer.cost": 120 },
    "expect": [ { "rule": "cheap", "path": "$.offer", "fields": ["cost"] } ] },
  { "name": "an arm without derived fields is left alone", "type": "Basket",
    "value": { "offer": { "kind": "free", "note": "x" } }, "expect": [] },

  { "name": "in a request the derived field that reads a readonly field is absent", "type": "Draft", "request": true,
    "value": { "qty": 3 },
    "computed": { "$.double": 6, "$.next": null }, "expect": [] },
  { "name": "in a response it is computed and the rule that reads it runs", "type": "Draft",
    "value": { "id": "a1b2c3d4-0000-0000-0000-000000000001", "serial": -5, "qty": 3 },
    "computed": { "$.double": 6, "$.next": -4 },
    "expect": [ { "rule": "after", "path": "$", "fields": ["next"] } ] },

  { "name": "a draft computes what it can and skips what reads an absent field", "type": "Draft", "partial": true,
    "value": { "qty": 4 },
    "computed": { "$.double": 8, "$.next": null }, "expect": [] }
] }
