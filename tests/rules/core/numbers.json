{ "cases": [
  { "name": "int sum under the limit", "type": "AddInt", "value": { "a": 1, "b": 2 }, "expect": [] },
  { "name": "int sum at the limit", "type": "AddInt", "value": { "a": 60, "b": 40 },
    "expect": [ { "rule": "small", "path": "$", "fields": ["a", "b"] } ] },
  { "name": "int add overflows at the top", "type": "AddInt", "value": { "a": 2147483647, "b": 1 },
    "expect": [ { "rule": "small", "path": "$", "fields": ["a", "b"], "error": "overflow" } ] },
  { "name": "int add overflows at the bottom", "type": "AddInt", "value": { "a": -2147483648, "b": -1 },
    "expect": [ { "rule": "small", "path": "$", "fields": ["a", "b"], "error": "overflow" } ] },

  { "name": "int product of two negatives", "type": "MulInt", "value": { "a": -3, "b": -4 }, "expect": [] },
  { "name": "int product negative", "type": "MulInt", "value": { "a": 3, "b": -4 },
    "expect": [ { "rule": "nonNegative", "path": "$", "fields": ["a", "b"] } ] },
  { "name": "largest square that fits an int", "type": "MulInt", "value": { "a": 46340, "b": 46340 }, "expect": [] },
  { "name": "smallest square that overflows an int", "type": "MulInt", "value": { "a": 46341, "b": 46341 },
    "expect": [ { "rule": "nonNegative", "path": "$", "fields": ["a", "b"], "error": "overflow" } ] },

  { "name": "division truncates toward zero and the remainder follows the dividend", "type": "DivInt",
    "value": { "a": -7, "b": 2 }, "expect": [] },
  { "name": "negative divisor", "type": "DivInt", "value": { "a": 7, "b": -2 },
    "expect": [ { "rule": "rest", "path": "$", "fields": ["a", "b"] } ] },
  { "name": "positive operands", "type": "DivInt", "value": { "a": 7, "b": 2 },
    "expect": [ { "rule": "half", "path": "$", "fields": ["a", "b"] },
                { "rule": "rest", "path": "$", "fields": ["a", "b"] } ] },
  { "name": "division and remainder by zero", "type": "DivInt", "value": { "a": 1, "b": 0 },
    "expect": [ { "rule": "half", "path": "$", "fields": ["a", "b"], "error": "division_by_zero" },
                { "rule": "rest", "path": "$", "fields": ["a", "b"], "error": "division_by_zero" } ] },
  { "name": "int min divided by minus one overflows and its remainder is zero", "type": "DivInt",
    "value": { "a": -2147483648, "b": -1 },
    "expect": [ { "rule": "half", "path": "$", "fields": ["a", "b"], "error": "overflow" },
                { "rule": "rest", "path": "$", "fields": ["a", "b"] } ] },

  { "name": "long arithmetic is exact beyond 2^53", "type": "LongMath",
    "value": { "a": "9007199254740992", "b": "9007199254740993" }, "expect": [] },
  { "name": "long arithmetic does not round like a double", "type": "LongMath",
    "value": { "a": "9007199254740992", "b": "9007199254740992" },
    "expect": [ { "rule": "exact", "path": "$", "fields": ["a", "b"] } ] },
  { "name": "long overflow at the top", "type": "LongMath",
    "value": { "a": "9223372036854775807", "b": "0" },
    "expect": [ { "rule": "exact", "path": "$", "fields": ["a", "b"], "error": "overflow" },
                { "rule": "bounded", "path": "$", "fields": ["a"], "error": "overflow" } ] },
  { "name": "negative long", "type": "LongMath", "value": { "a": "-5", "b": "-4" },
    "expect": [ { "rule": "bounded", "path": "$", "fields": ["a"] } ] },

  { "name": "int widens exactly to long, decimal and float", "type": "Widen",
    "value": { "n": 2, "big": "3", "price": "49.99", "ratio": 0.5 }, "expect": [] },
  { "name": "widened comparisons at their limits", "type": "Widen",
    "value": { "n": 3, "big": "3", "price": "33.34", "ratio": 0.5 },
    "expect": [ { "rule": "intToLong", "path": "$", "fields": ["n", "big"] },
                { "rule": "intToDecimal", "path": "$", "fields": ["n", "price"] },
                { "rule": "intToFloat", "path": "$", "fields": ["n", "ratio"] } ] },

  { "name": "a false left operand skips the division", "type": "Guarded", "value": { "a": 10, "b": 0 },
    "expect": [ { "rule": "safe", "path": "$", "fields": ["b", "a"] } ] },
  { "name": "guarded remainder", "type": "Guarded", "value": { "a": 10, "b": 3 },
    "expect": [ { "rule": "alt", "path": "$", "fields": ["b", "a"] } ] },
  { "name": "guarded division passes", "type": "Guarded", "value": { "a": 10, "b": 5 }, "expect": [] }
] }
