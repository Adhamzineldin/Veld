{ "cases": [
  { "name": "every rule holds", "type": "Party",
    "value": { "guests": 2, "size": 4 },
    "expect": [], "audited": [] },
  { "name": "an audited invariant that is violated does not reject", "type": "Party",
    "value": { "guests": 7, "size": 10 },
    "expect": [],
    "audited": [ { "rule": "smallParty", "path": "$", "fields": ["guests"] } ] },
  { "name": "an enforced violation is in expect and an audited evaluation error is only audited", "type": "Party",
    "value": { "guests": 0, "size": 4 },
    "expect": [ { "rule": "positive", "path": "$", "fields": ["guests"] } ],
    "audited": [ { "rule": "divisible", "path": "$", "fields": ["size", "guests"], "error": "division_by_zero" } ] },
  { "name": "an overflow in an audited invariant does not reject", "type": "Party",
    "value": { "guests": 1, "size": 2147483647 },
    "expect": [],
    "audited": [ { "rule": "headroom", "path": "$", "fields": ["size"], "error": "overflow" } ] },
  { "name": "in request position an audited invariant is still reported", "type": "Party",
    "request": true,
    "value": { "guests": 9, "size": 4 },
    "expect": [],
    "audited": [ { "rule": "smallParty", "path": "$", "fields": ["guests"] },
                 { "rule": "fits", "path": "$", "fields": ["guests", "size"] },
                 { "rule": "divisible", "path": "$", "fields": ["size", "guests"] } ] },
  { "name": "the partial check of a client skips audited invariants", "type": "Party",
    "partial": true,
    "value": { "guests": 7, "size": 4 },
    "expect": [], "audited": [] },
  { "name": "audited and enforced violations are told apart inside a list", "type": "Group",
    "value": { "parties": [ { "guests": 7, "size": 10 }, { "guests": 0, "size": 1 } ] },
    "expect": [ { "rule": "positive", "path": "$.parties[1]", "fields": ["guests"] } ],
    "audited": [ { "rule": "smallParty", "path": "$.parties[0]", "fields": ["guests"] },
                 { "rule": "divisible", "path": "$.parties[1]", "fields": ["size", "guests"], "error": "division_by_zero" } ] },
  { "name": "an inherited audited invariant stays audited in the child", "type": "Big",
    "value": { "guests": 8, "size": 8, "extra": 0 },
    "expect": [],
    "audited": [ { "rule": "smallParty", "path": "$", "fields": ["guests"] } ] }
] }
