{ "cases": [
  { "name": "strict (the default) reports an audited output rule", "type": "Roster",
    "value": { "guests": 9 },
    "expect": [],
    "audited": [ { "rule": "smallParty", "path": "$", "fields": ["guests"] } ] },
  { "name": "output mode off does not report an audited output rule", "type": "Roster",
    "output": "off",
    "value": { "guests": 9 },
    "expect": [], "audited": [] },
  { "name": "output mode off does not evaluate an enforced output rule either", "type": "Roster",
    "output": "off",
    "value": { "guests": 0 },
    "expect": [], "audited": [] },
  { "name": "an audited input rule is evaluated in every mode", "type": "Roster",
    "request": true, "output": "off",
    "value": { "guests": 9 },
    "expect": [],
    "audited": [ { "rule": "smallParty", "path": "$", "fields": ["guests"] } ] },
  { "name": "an enforced input rule is evaluated in every mode", "type": "Roster",
    "request": true, "output": "off",
    "value": { "guests": 0 },
    "expect": [ { "rule": "positive", "path": "$", "fields": ["guests"] } ],
    "audited": [] }
] }
