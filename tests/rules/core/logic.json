{ "cases": [
  { "name": "implies is right associative", "type": "Logic",
    "value": { "a": true, "b": true, "c": false, "n": 1 },
    "expect": [ { "rule": "chain", "path": "$", "fields": ["a", "b", "c"] },
                { "rule": "negated", "path": "$", "fields": ["a", "b"] },
                { "rule": "grouped", "path": "$", "fields": ["a", "b", "c", "n"] } ] },
  { "name": "and binds tighter than or", "type": "Logic",
    "value": { "a": false, "b": true, "c": false, "n": -1 },
    "expect": [ { "rule": "mixed", "path": "$", "fields": ["a", "b", "c"] },
                { "rule": "grouped", "path": "$", "fields": ["a", "b", "c", "n"] } ] },
  { "name": "not binds tighter than a comparison", "type": "Logic",
    "value": { "a": false, "b": false, "c": true, "n": 0 },
    "expect": [ { "rule": "mixed", "path": "$", "fields": ["a", "b", "c"] },
                { "rule": "negated", "path": "$", "fields": ["a", "b"] },
                { "rule": "minus", "path": "$", "fields": ["n"] },
                { "rule": "grouped", "path": "$", "fields": ["a", "b", "c", "n"] } ] },
  { "name": "arithmetic precedence and a subtraction written without a space", "type": "Logic",
    "value": { "a": true, "b": false, "c": false, "n": 6 },
    "expect": [ { "rule": "tight", "path": "$", "fields": ["n"] },
                { "rule": "grouped", "path": "$", "fields": ["a", "b", "c", "n"] } ] },
  { "name": "the arithmetic alternative holds", "type": "Logic",
    "value": { "a": false, "b": true, "c": true, "n": 3 }, "expect": [] },
  { "name": "negating the smallest int overflows", "type": "Logic",
    "value": { "a": true, "b": false, "c": false, "n": -2147483648 },
    "expect": [ { "rule": "minus", "path": "$", "fields": ["n"], "error": "overflow" },
                { "rule": "tight", "path": "$", "fields": ["n"], "error": "overflow" },
                { "rule": "grouped", "path": "$", "fields": ["a", "b", "c", "n"], "error": "overflow" } ] }
] }
