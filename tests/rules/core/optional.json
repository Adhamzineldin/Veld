{ "cases": [
  { "name": "uuids compare in lower case", "type": "Ticket",
    "value": { "id": "A1B2C3D4-0000-0000-0000-000000000001", "owner": "a1b2c3d4-0000-0000-0000-000000000001", "status": "pending" },
    "expect": [ { "rule": "own", "path": "$", "fields": ["id", "owner"] } ] },
  { "name": "an enum literal matches the wire value of its variant", "type": "Ticket",
    "value": { "id": "a1b2c3d4-0000-0000-0000-000000000001", "owner": "a1b2c3d4-0000-0000-0000-000000000002", "status": "CHECKED_IN" },
    "expect": [ { "rule": "paidHasTime", "path": "$", "fields": ["status", "paidAt"] } ] },
  { "name": "paid with a time", "type": "Ticket",
    "value": { "id": "a1b2c3d4-0000-0000-0000-000000000001", "owner": "a1b2c3d4-0000-0000-0000-000000000002",
               "status": "paid", "paidAt": "2026-01-01T00:00:00Z", "previous": "pending" },
    "expect": [] },
  { "name": "cancelled, and the previous status is the same", "type": "Ticket",
    "value": { "id": "a1b2c3d4-0000-0000-0000-000000000001", "owner": "a1b2c3d4-0000-0000-0000-000000000002",
               "status": "cancelled", "previous": "cancelled" },
    "expect": [ { "rule": "notCancelled", "path": "$", "fields": ["status"] },
                { "rule": "moved", "path": "$", "fields": ["previous", "status"] } ] },

  { "name": "every optional value absent", "type": "Profile", "value": { "name": "a" }, "expect": [] },
  { "name": "every guard fails", "type": "Profile",
    "value": { "name": "a", "nick": "toolong", "age": 17, "address": { "city": "x" } },
    "expect": [ { "rule": "nickShort", "path": "$", "fields": ["nick"] },
                { "rule": "adult", "path": "$", "fields": ["age"] },
                { "rule": "zipped", "path": "$", "fields": ["address"] } ] },
  { "name": "every guard passes", "type": "Profile",
    "value": { "name": "a", "nick": "ok", "age": 18, "address": { "city": "x", "zip": "12345" } },
    "expect": [] },
  { "name": "a nick without an age", "type": "Profile",
    "value": { "name": "a", "nick": "ok" },
    "expect": [ { "rule": "both", "path": "$", "fields": ["nick", "age"] } ] }
] }
