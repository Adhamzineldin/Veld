{ "cases": [
  { "name": "exactly thirty days", "type": "Stay",
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-01-31T00:00:00Z" }, "expect": [] },
  { "name": "one millisecond over thirty days", "type": "Stay",
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-01-31T00:00:00.001Z" },
    "expect": [ { "rule": "maxStay", "path": "$", "fields": ["end", "start"] } ] },
  { "name": "ends before it starts", "type": "Stay",
    "value": { "start": "2026-01-02T00:00:00Z", "end": "2026-01-01T00:00:00Z" },
    "expect": [ { "rule": "endAfterStart", "path": "$", "fields": ["end", "start"] } ] },
  { "name": "an offset is the same instant", "type": "Stay",
    "value": { "start": "2026-01-01T02:00:00+02:00", "end": "2026-01-01T00:00:00Z" },
    "expect": [ { "rule": "endAfterStart", "path": "$", "fields": ["end", "start"] } ] },
  { "name": "digits below a millisecond are dropped", "type": "Stay",
    "value": { "start": "2026-01-01T00:00:00.000Z", "end": "2026-01-01T00:00:00.000999Z" },
    "expect": [ { "rule": "endAfterStart", "path": "$", "fields": ["end", "start"] } ] },
  { "name": "one millisecond later", "type": "Stay",
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-01-01T00:00:00.001Z" }, "expect": [] },

  { "name": "two hours apart", "type": "Instants",
    "value": { "a": "2026-03-01T10:00:00Z", "b": "2026-03-01T12:00:00Z" },
    "expect": [ { "rule": "same", "path": "$", "fields": ["a", "b"] } ] },
  { "name": "equal instants written with different offsets", "type": "Instants",
    "value": { "a": "2026-03-01T10:00:00Z", "b": "2026-03-01T13:00:00+03:00" },
    "expect": [ { "rule": "shifted", "path": "$", "fields": ["a", "b"] },
                { "rule": "back", "path": "$", "fields": ["b", "a"] } ] },

  { "name": "a week across the end of February", "type": "Dates",
    "value": { "first": "2026-02-25", "last": "2026-03-04" }, "expect": [] },
  { "name": "the same dates in a leap year are eight days", "type": "Dates",
    "value": { "first": "2024-02-25", "last": "2024-03-04" },
    "expect": [ { "rule": "week", "path": "$", "fields": ["last", "first"] } ] },
  { "name": "dates out of order", "type": "Dates",
    "value": { "first": "2026-03-04", "last": "2026-02-25" },
    "expect": [ { "rule": "ordered", "path": "$", "fields": ["first", "last"] },
                { "rule": "week", "path": "$", "fields": ["last", "first"] } ] },

  { "name": "opening hours", "type": "Clock", "value": { "opens": "09:00:00", "closes": "17:30:00" }, "expect": [] },
  { "name": "times equal after dropping digits below a millisecond", "type": "Clock",
    "value": { "opens": "09:00:00.500", "closes": "09:00:00.5001" },
    "expect": [ { "rule": "ordered", "path": "$", "fields": ["opens", "closes"] } ] },
  { "name": "midnight is the smallest time", "type": "Clock", "value": { "opens": "23:59:59", "closes": "00:00:00" },
    "expect": [ { "rule": "ordered", "path": "$", "fields": ["opens", "closes"] } ] },

  { "name": "one day is longer than one hour", "type": "Dur", "value": { "n": "1" }, "expect": [] },
  { "name": "zero days", "type": "Dur", "value": { "n": "0" },
    "expect": [ { "rule": "fits", "path": "$", "fields": ["n"] } ] },
  { "name": "the largest number of days that fits", "type": "Dur", "value": { "n": "106751991167" }, "expect": [] },
  { "name": "one more day overflows a duration", "type": "Dur", "value": { "n": "106751991168" },
    "expect": [ { "rule": "fits", "path": "$", "fields": ["n"], "error": "overflow" } ] }
] }
