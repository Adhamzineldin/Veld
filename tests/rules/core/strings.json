{ "cases": [
  { "name": "three ascii characters", "type": "Text", "value": { "s": "abc" }, "expect": [] },
  { "name": "three astral characters are three code points", "type": "Text",
    "value": { "s": "😀😀😀" }, "expect": [] },
  { "name": "combining marks count as code points", "type": "Text", "value": { "s": "éé" },
    "expect": [ { "rule": "short", "path": "$", "fields": ["s"] } ] },
  { "name": "prefix and length", "type": "Text", "value": { "s": "admin1" },
    "expect": [ { "rule": "short", "path": "$", "fields": ["s"] },
                { "rule": "noAdmin", "path": "$", "fields": ["s"] } ] },

  { "name": "equal strings with an astral suffix", "type": "Strs",
    "value": { "a": "x😀", "b": "x😀" },
    "expect": [ { "rule": "inner", "path": "$", "fields": ["b"] } ] },
  { "name": "precomposed and decomposed text are different strings", "type": "Strs",
    "value": { "a": "é", "b": "é" },
    "expect": [ { "rule": "same", "path": "$", "fields": ["a", "b"] },
                { "rule": "suffix", "path": "$", "fields": ["a"] },
                { "rule": "inner", "path": "$", "fields": ["b"] } ] },
  { "name": "suffix and substring found", "type": "Strs",
    "value": { "a": "caf😀", "b": "café" },
    "expect": [ { "rule": "same", "path": "$", "fields": ["a", "b"] } ] },

  { "name": "anchored pattern matches", "type": "Pattern", "value": { "code": "ABC-1234" }, "expect": [] },
  { "name": "anchored pattern is case sensitive", "type": "Pattern", "value": { "code": "abc-1234" },
    "expect": [ { "rule": "shape", "path": "$", "fields": ["code"] } ] },
  { "name": "an unanchored pattern matches anywhere", "type": "Pattern", "value": { "code": "ABCD" },
    "expect": [ { "rule": "shape", "path": "$", "fields": ["code"] },
                { "rule": "hasDigit", "path": "$", "fields": ["code"] } ] },

  { "name": "bytes, list and map sizes", "type": "Sizes",
    "value": { "data": "AQID", "tags": ["gift", "x"], "limits": { "max": 5, "min": 1 } }, "expect": [] },
  { "name": "four bytes, three tags, no key", "type": "Sizes",
    "value": { "data": "AQIDBA==", "tags": ["a", "b", "c"], "limits": {} },
    "expect": [ { "rule": "smallData", "path": "$", "fields": ["data"] },
                { "rule": "fewTags", "path": "$", "fields": ["tags"] },
                { "rule": "hasMax", "path": "$", "fields": ["limits"] },
                { "rule": "gift", "path": "$", "fields": ["tags"] } ] },
  { "name": "empty list passes the alternative", "type": "Sizes",
    "value": { "data": "", "tags": [], "limits": { "max": 0 } }, "expect": [] }
] }
