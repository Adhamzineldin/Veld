{ "cases": [
  { "name": "an inherited rule is checked on the child", "type": "Range", "value": { "low": 5, "high": 1, "step": 1 },
    "expect": [ { "rule": "ordered", "path": "$", "fields": ["low", "high"] },
                { "rule": "stepFits", "path": "$", "fields": ["step", "high", "low"] } ] },
  { "name": "a valid range", "type": "Range", "value": { "low": 1, "high": 5, "step": 4 }, "expect": [] },

  { "name": "violations inside a list, a map and a page", "type": "Grid",
    "value": { "rows": [ { "low": 1, "high": 5, "step": 2 }, { "low": 5, "high": 1, "step": 1 } ],
               "named": { "k": { "low": 2, "high": 1 } },
               "page": { "items": [ { "low": 3, "high": 2 } ], "total": "1", "page": 1, "size": 10 } },
    "expect": [ { "rule": "ordered", "path": "$.rows[1]", "fields": ["low", "high"] },
                { "rule": "stepFits", "path": "$.rows[1]", "fields": ["step", "high", "low"] },
                { "rule": "ordered", "path": "$.named.k", "fields": ["low", "high"] },
                { "rule": "ordered", "path": "$.page.items[0]", "fields": ["low", "high"] } ] },
  { "name": "an optional nested model, and rules on the outer value", "type": "Grid",
    "value": { "rows": [], "named": {}, "main": { "low": 1, "high": 2, "step": 5 },
               "page": { "items": [ { "low": 1, "high": 1 }, { "low": 2, "high": 2 } ], "total": "2", "page": 1, "size": 1 } },
    "expect": [ { "rule": "hasRows", "path": "$", "fields": ["rows"] },
                { "rule": "pageFull", "path": "$", "fields": ["page"] },
                { "rule": "stepFits", "path": "$.main", "fields": ["step", "high", "low"] } ] },

  { "name": "a rule on a union arm", "type": "Checkout", "value": { "payment": { "kind": "card", "last4": "123" } },
    "expect": [ { "rule": "four", "path": "$.payment", "fields": ["last4"] } ] },
  { "name": "an arm without rules, and an optional arm with one", "type": "Checkout",
    "value": { "payment": { "kind": "bank", "iban": "x" }, "backup": { "kind": "card", "last4": "12345" } },
    "expect": [ { "rule": "four", "path": "$.backup", "fields": ["last4"] } ] },

  { "name": "a request skips rules that read a readonly field", "type": "Draft", "request": true,
    "value": { "title": "", "copies": 0 },
    "expect": [ { "rule": "titled", "path": "$", "fields": ["title"] },
                { "rule": "hasCopies", "path": "$", "fields": ["copies"] } ] },
  { "name": "a default is applied before the rules run", "type": "Draft", "request": true,
    "value": { "title": "x" }, "expect": [] },
  { "name": "a response checks every rule", "type": "Draft",
    "value": { "id": "a1b2c3d4-0000-0000-0000-000000000001", "title": "x", "copies": 1, "createdBy": "" },
    "expect": [ { "rule": "ownerNamed", "path": "$", "fields": ["createdBy"] } ] },

  { "name": "a partial draft skips rules whose required fields are absent", "type": "Form", "partial": true,
    "value": { "start": "2026-01-05" }, "expect": [] },
  { "name": "a partial draft checks the rules it can", "type": "Form", "partial": true,
    "value": { "start": "2026-01-05", "end": "2026-01-01", "note": "long!" },
    "expect": [ { "rule": "ordered", "path": "$", "fields": ["start", "end"] },
                { "rule": "noteShort", "path": "$", "fields": ["note"] } ] },
  { "name": "a partial draft with one field", "type": "Form", "partial": true,
    "value": { "guests": 0 },
    "expect": [ { "rule": "some", "path": "$", "fields": ["guests"] } ] }
] }
