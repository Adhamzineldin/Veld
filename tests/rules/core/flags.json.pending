{ "cases": [
  { "name": "a flagged invariant that is off is not evaluated", "type": "Stay",
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-03-01T00:00:00Z", "guests": 2 },
    "expect": [] },
  { "name": "the same value is rejected once the flag is on", "type": "Stay",
    "flags": ["shortStays"],
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-03-01T00:00:00Z", "guests": 2 },
    "expect": [ { "rule": "maxStay", "path": "$", "fields": ["end", "start"] } ] },
  { "name": "a flagged invariant that holds reports nothing when it is on", "type": "Stay",
    "flags": ["shortStays"],
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-01-08T00:00:00Z", "guests": 2 },
    "expect": [] },
  { "name": "an invariant without a flag always applies", "type": "Stay",
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-01-02T00:00:00Z", "guests": 0 },
    "expect": [ { "rule": "positive", "path": "$", "fields": ["guests"] } ] },
  { "name": "two flags are independent", "type": "Stay",
    "flags": ["smallGroups"],
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-03-01T00:00:00Z", "guests": 9 },
    "expect": [ { "rule": "smallGroup", "path": "$", "fields": ["guests"] } ] },
  { "name": "both flags on report both rules", "type": "Stay",
    "flags": ["smallGroups", "shortStays"],
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-03-01T00:00:00Z", "guests": 9 },
    "expect": [ { "rule": "maxStay", "path": "$", "fields": ["end", "start"] },
                { "rule": "smallGroup", "path": "$", "fields": ["guests"] } ] },
  { "name": "when the provider fails an invariant counts as on", "type": "Stay",
    "provider": "failed",
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-03-01T00:00:00Z", "guests": 9 },
    "expect": [ { "rule": "maxStay", "path": "$", "fields": ["end", "start"] },
                { "rule": "smallGroup", "path": "$", "fields": ["guests"] } ] },
  { "name": "a flagged invariant is checked inside a list", "type": "Stays",
    "flags": ["smallGroups"],
    "value": { "items": [ { "start": "2026-01-01T00:00:00Z", "end": "2026-01-02T00:00:00Z", "guests": 2 },
                          { "start": "2026-01-01T00:00:00Z", "end": "2026-01-02T00:00:00Z", "guests": 7 } ] },
    "expect": [ { "rule": "smallGroup", "path": "$.items[1]", "fields": ["guests"] } ] },
  { "name": "an inherited flagged invariant keeps its flag in the child", "type": "Child",
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-03-01T00:00:00Z", "guests": 2, "note": "n" },
    "expect": [] },
  { "name": "an inherited flagged invariant applies in the child once the flag is on", "type": "Child",
    "flags": ["shortStays"],
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-03-01T00:00:00Z", "guests": 2, "note": "n" },
    "expect": [ { "rule": "maxStay", "path": "$", "fields": ["end", "start"] } ] },
  { "name": "the partial check of a client skips a flagged invariant", "type": "Stay",
    "partial": true, "flags": ["shortStays"],
    "value": { "start": "2026-01-01T00:00:00Z", "end": "2026-03-01T00:00:00Z", "guests": 2 },
    "expect": [] }
] }
