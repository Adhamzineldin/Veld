// `allow` belongs to a later phase of spec/rules.md (policies): it is rejected with a diagnostic
// that names its phase, and the next statement still parses.

model Booking { id: uuid }

service Bookings at "/bookings" {
  post "/" create(body: Booking) -> 201 Booking {
    allow ManageBooking(body)
    require body.id == body.id
  }
}
