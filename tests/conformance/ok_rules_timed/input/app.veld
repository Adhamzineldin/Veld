// Timed moves: `flow ... after` and `transition ... since`.

enum BookingStatus {
  pending, paid, cancelled
  flow pending -> paid
  flow pending -> cancelled after hours(24)
  final paid, cancelled
}

model Stamps { entered: datetime }

model Booking {
  id: uuid @readonly
  status: BookingStatus = .pending
  pendingSince: datetime
  stamps: Stamps
}

service Bookings at "/bookings" {
  post "/{id}/expire" expireBooking(id: uuid) -> Booking {
    fact booking: Booking = id
    transition booking.status: pending -> cancelled since booking.pendingSince
  }
}

enum Doc {
  draft, stale
  flow draft -> stale after days(1) + hours(12)
  final stale
}

model Page { id: uuid, state: Doc, stamps: Stamps }

service Pages at "/pages" {
  post "/{id}/stale" markStale(id: uuid) -> 204 {
    fact page: Page = id
    transition page.state: draft -> stale since page.stamps.entered
  }
}

example "a due booking expires" {
  given booking = { status: .pending, pendingSince: "2026-06-10T12:00:00Z" }
  at "2026-06-11T12:00:00Z"
  expireBooking(id: booking.id) -> ok
}
