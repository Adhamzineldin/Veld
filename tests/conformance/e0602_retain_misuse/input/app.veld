// `@retain` stands on a model and nowhere else (spec/platform.md section 23).

@retain(days(30), since: at, then: delete)
error Gone 410 {
  at: datetime
}

@retain(days(30), since: at, then: delete)
enum Phase { open, closed }

model OnAField {
  at: datetime @retain(days(30), since: at, then: delete)
}
